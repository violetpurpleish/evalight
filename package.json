{
  "name": "evalight",
  "version": "0.1.0",
  "private": true,
  "description": "A small live ClojureScript environment that starts in the browser.",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun scripts/dev.mjs",
    "watch": "shadow-cljs watch app preview",
    "release": "shadow-cljs release app preview && bun scripts/copy-embed.mjs",
    "embed": "shadow-cljs release workshop workshop-preview",
    "local": "bun scripts/local-server.mjs",
    "test": "shadow-cljs compile test && bun out/node-tests.js && bun test/evalight/smart_indent.test.mjs && bun test/evalight/bencode.test.mjs && bun test/evalight/overlay.test.mjs && bun test/evalight/attach.test.mjs && bun test/evalight/build-id.test.mjs && bun test/ui/layout.test.mjs && bun test/evalight/pack.test.mjs && bun test/evalight/embed.test.mjs",
    "test:ui": "bun test/ui/layout.test.mjs",
    "postinstall": "bun scripts/dedupe-codemirror.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^25.9.0",
    "shadow-cljs": "2.28.23"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/lint": "^6.8.4",
    "@codemirror/merge": "^6.7.4",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "^6.36.4",
    "@lezer/highlight": "^1.2.1",
    "@nextjournal/clojure-mode": "^0.3.3",
    "jszip": "^3.10.1",
    "parinfer": "3.13.1"
  },
  "overrides": {
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@codemirror/commands": "6.11.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@lezer/highlight": "1.2.1"
  }
}
