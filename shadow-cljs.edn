{:source-paths ["src" "test"]
 :dependencies
 [[no.cjohansen/replicant "2026.07.1"]
  [org.babashka/sci "0.15.58"]]
 :nrepl {:port 7888}
 :node-modules {:managed-by :bun}
 :builds
 {:app
  {:target :browser
   :output-dir "public/js"
   :asset-path "/js"
   :modules {:main {:init-fn evalight.core/init}}
   :devtools {:preloads []}
   :js-options
   {:resolve
    {"@codemirror/state" {:target :npm :require "@codemirror/state"}
     "@codemirror/view" {:target :npm :require "@codemirror/view"}
     "@codemirror/language" {:target :npm :require "@codemirror/language"}
     "@codemirror/commands" {:target :npm :require "@codemirror/commands"}
     "@codemirror/search" {:target :npm :require "@codemirror/search"}
     "@codemirror/lint" {:target :npm :require "@codemirror/lint"}
     "@lezer/common" {:target :npm :require "@lezer/common"}
     "@lezer/highlight" {:target :npm :require "@lezer/highlight"}}}}

  :preview
  {:target :browser
   :output-dir "public/js/preview"
   :asset-path "/js/preview"
   :modules {:preview {:init-fn evalight.preview.runtime/init}}}

  :test
  {:target :node-test
   :output-to "out/node-tests.js"
   :ns-regexp "-test$"
   :autorun true}}}
