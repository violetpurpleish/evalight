{:source-paths ["src" "test"]
 :dependencies
 [[no.cjohansen/replicant "2026.07.1"]
  [org.babashka/sci "0.15.58"]]
 :nrepl {:port 7888}
 :node-modules {:managed-by :bun}
 :builds
 { :app
  {:target :browser
   :output-dir "public/js"
   :asset-path "/js"
   :modules {:main {:init-fn evalight.core/init}}
   :devtools {:preloads []}
   ;; Watch stays :none. Release uses :simple so Closure does not rename
   ;; CodeMirror methods that src/evalight/cm6_parinfer.js calls.
   :release {:compiler-options {:optimizations :simple}}
   :js-options
   {:resolve
    {"@codemirror/state" {:target :file :file "node_modules/@codemirror/state/dist/index.cjs"}
     "@codemirror/view" {:target :file :file "node_modules/@codemirror/view/dist/index.cjs"}
     "@codemirror/commands" {:target :file :file "node_modules/@codemirror/commands/dist/index.cjs"}
     "@codemirror/language" {:target :file :file "node_modules/@codemirror/language/dist/index.cjs"}
     "@codemirror/lint" {:target :file :file "node_modules/@codemirror/lint/dist/index.cjs"}
     "@codemirror/search" {:target :file :file "node_modules/@codemirror/search/dist/index.cjs"}
     "@codemirror/merge" {:target :file :file "node_modules/@codemirror/merge/dist/index.cjs"}
     "@codemirror/autocomplete" {:target :file :file "node_modules/@codemirror/autocomplete/dist/index.cjs"}}}}

  :preview
  {:target :browser
   :output-dir "public/js/preview"
   :asset-path "/js/preview"
   :modules {:preview {:init-fn evalight.preview.runtime/init}}
   ;; Sandboxed iframe (allow-scripts only). The watch client would
   ;; document.location.reload() preview.html, which the browser
   ;; rejects as a navigation from a unique origin, and the lamp
   ;; never paints.
   :devtools {:enabled false}}

  :test
  {:target :node-test
   :output-to "out/node-tests.js"
   :ns-regexp "-test$"
   :autorun true}

  ;; Self-contained workshop UI copied into an exported project.
  ;; Watch builds load cljs-runtime; these release files do not.
  :workshop
  {:target :browser
   :output-dir "evalight-ui/js"
   :asset-path "/js"
   :modules {:main {:init-fn evalight.core/init}}
   :devtools {:preloads []}
   :release {:compiler-options {:optimizations :simple}}
   :js-options
   {:resolve
    {"@codemirror/state" {:target :file :file "node_modules/@codemirror/state/dist/index.cjs"}
     "@codemirror/view" {:target :file :file "node_modules/@codemirror/view/dist/index.cjs"}
     "@codemirror/commands" {:target :file :file "node_modules/@codemirror/commands/dist/index.cjs"}
     "@codemirror/language" {:target :file :file "node_modules/@codemirror/language/dist/index.cjs"}
     "@codemirror/lint" {:target :file :file "node_modules/@codemirror/lint/dist/index.cjs"}
     "@codemirror/search" {:target :file :file "node_modules/@codemirror/search/dist/index.cjs"}
     "@codemirror/merge" {:target :file :file "node_modules/@codemirror/merge/dist/index.cjs"}
     "@codemirror/autocomplete" {:target :file :file "node_modules/@codemirror/autocomplete/dist/index.cjs"}}}}

  :workshop-preview
  {:target :browser
   :output-dir "evalight-ui/js/preview"
   :asset-path "/js/preview"
   :modules {:preview {:init-fn evalight.preview.runtime/init}}
   :devtools {:enabled false}}}}
