{:source-paths ["src" "test"]
 :dependencies
 [[no.cjohansen/replicant "2026.07.1"]
  [org.babashka/sci "0.15.58"]]
 :nrepl {:port 7888}
 :node-modules {:managed-by :bun}
 :builds
 {:app
  {:target :browser
   :output-dir "public/js"
   :asset-path "/js"
   :modules {:main {:init-fn evalight.core/init}}
   :devtools {:preloads []}}

  :preview
  {:target :browser
   :output-dir "public/js/preview"
   :asset-path "/js/preview"
   :modules {:preview {:init-fn evalight.preview.runtime/init}}}

  :test
  {:target :node-test
   :output-to "out/node-tests.js"
   :ns-regexp "-test$"
   :autorun true}}}
